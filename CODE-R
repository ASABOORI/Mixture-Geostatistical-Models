  lppd6[t] = mcmc.out6$WAIC$lppd
  pWAIC6[t] = mcmc.out6$WAIC$pWAIC
  
  
  #LPML
  mcmc.sample6 = (mcmc.out6$samples$chain1 + mcmc.out6$samples$chain2) / 2
  Mu = mcmc.sample6[, 2:388]
  Omega = mcmc.sample6[, 389]
  P = mcmc.sample6[, 390]
  Phi = mcmc.sample6[, 391]
  n = length(y)
  m = nrow(mcmc.sample6)
  CPO = Density = c()
  for(i in 1:n){
    for(k in 1:m){
      Density[k] = 1/(P[k]*dbeta(y[i],shape1 = Phi[k]*Lambda1[k,i], shape2 = Phi[k]*(1-Lambda1[k,i]))+
                        (1-P[k])*dbeta(y[i],shape1 = Phi[k]*Lambda2[k,i], shape2 = Phi[k]*(1-Lambda2[k,i])))
    }
    CPO[i] = 1/mean(Density)
  }
  LPML6[t] = sum(log(CPO))
  
  
  #DIC
  D = rep(NA, m)
  Wtilde=matrix(,m,n)
  for(k in 1:m){
    for (i in 1:n) {
      Wtilde[k,i] <- Omega[k]* min(Mu[k,i]/P[k], (1 - Mu[k,i])/(1 - P[k]))
      Lambda1[k,i] <- Mu[k,i] + (1 - P[k]) * Wtilde[k,i]
      Lambda2[k,i] <- Mu[k,i] - P[k] * Wtilde[k,i]
    }}
  for(k in 1:m){
    D[k] = -2*sum(log((P[k]*dbeta(y,shape1 = Phi[k]*Lambda1[k,], shape2 = Phi[k]*(1-Lambda1[k,]))+
                         (1-P[k])*dbeta(y,shape1 = Phi[k]*Lambda2[k,], shape2 = Phi[k]*(1-Lambda2[k,])))))
  }
  D.bar_theta = mean(D)
  Lambda1.bar = apply(Lambda1, 2, "mean")
  Lambda2.bar = apply(Lambda2, 2, "mean")
  P.bar =mean( mcmc.sample6[, 390])
  Phi.bar = mean(mcmc.sample6[, 391])
  D_theta.bar = -2*sum(log(P.bar*dbeta(y, shape1 = Phi.bar*Lambda1.bar, shape2 = Phi.bar*(1-Lambda1.bar))+
                             (1-P.bar)*dbeta(y, shape1 = Phi.bar*Lambda2.bar, shape2 = Phi.bar*(1-Lambda2.bar))))
  DIC6[t] = 2*D.bar_theta - D_theta.bar
  
  
}

