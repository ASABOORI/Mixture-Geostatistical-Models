    W[1:n] ~ dmnorm(zero[1:n], cov = Sigma[1:n, 1:n])
    
    
    # Priors
    beta0 ~ dnorm(0, var = 100)
    delta ~ dgamma(0.01, 0.01)
    nu ~ dunif(2, 50)
    sigma2 <- exp(sigmastar)
    sigmastar ~ dunif(-2, 2)
    
  })
  Consts <- list(n = length(y), dists = dists, zero = rep(0, length(y)), theta = max(dists) / 3)
  Inits <- list (beta0 = 0, delta=1, nu=10, sigma2 = 1, W = rep(0, Consts$n))
  mcmc.out5 <- nimbleMCMC(code = Code, data = Data, constants = Consts, inits = Inits,
                          niter = n.itr, nburnin = n.burn, thin =  n.thin, nchains = 2, 
                          monitors = c( 'beta0', 'delta','nu','sigma2','ksi', 'y'),
                          summary = TRUE, WAIC = TRUE)
  
  bayes.est5 = mcmc.out5$summary$all.chain[c(1,2, 390, 391), ]
  Output5[[t]] <- bayes.est5
  beta0.M5[t] <- Output5[[t]][1, 1]
  delta.M5[t] <- Output5[[t]][2, 1]
  nu.M5[t] <- Output5[[t]][3, 1]
  sigma2.M5[t] <- Output5[[t]][4, 1]
  
  
  # WAIC
  WAIC5[t] =  mcmc.out5$WAIC$WAIC
  lppd5[t] = mcmc.out5$WAIC$lppd
  pWAIC5[t] = mcmc.out5$WAIC$pWAIC
  
  
  #LPML
  mcmc.sample5 = (mcmc.out5$samples$chain1 + mcmc.out5$samples$chain2) / 2
  
  #LPML
  Ksi = mcmc.sample5[, 3:389]
  Delta = mcmc.sample5[, 2]
  Nu = mcmc.sample5[, 390]
  n = length(y)
  m = nrow(mcmc.sample5)
  CPO = rep(NA, n)
  Density = rep(NA, m)
  for(i in 1:n){
    for(k in 1:m){
      Density[k] = 1/(((Delta[k] * (Nu[k] ^ (Nu[k] / 2))) / (y[i] * (1 - y[i]) * beta(0.5, Nu[k]/2))) * 
                        (Nu[k] + (qt(0.5, df = Nu[k]) + Delta[k] * (log(y[i] / (1 - y[i])) - log(Ksi[k, i] / (1 - Ksi[k, i])))) ^ 2) ^ (- (Nu[k] + 1) / 2))
    }
    CPO[i] = 1/mean(Density)
  }
  LPML5[t] = sum(log(CPO))
  
  
  #DIC
  D = rep(NA, m)
  for(k in 1:m){
    D[k] = -2*sum(log(((Delta[k] * (Nu[k] ^ (Nu[k] / 2))) / (y * (1 - y) * beta(0.5, Nu[k]/2))) * 
                        (Nu[k] + (qt(0.5, df = Nu[k]) + Delta[k] * (log(y / (1 - y)) - log(Ksi[k, ] / (1 - Ksi[k, ])))) ^ 2) ^ (- (Nu[k] + 1) / 2)))
  }
  
  D.bar_theta = mean(D)
  
  ksi.bar = apply(Ksi, 2, "mean")
  Delta.bar = mean(mcmc.sample5[, 2])
  Nu.bar = mean(mcmc.sample5[, 390])
  D_theta.bar = -2*sum(log(((Delta.bar * (Nu.bar ^ (Nu.bar / 2))) / (y * (1 - y) * beta(0.5, Nu.bar/2))) * 
