  omega.M6[t] <- Output6[[t]][2, 1]
  p.M6[t] <- Output6[[t]][3, 1]
  phi.M6[t] <- Output6[[t]][4, 1]
  sigma2.M6[t] <- Output6[[t]][6, 1]
  
  
  # WAIC
