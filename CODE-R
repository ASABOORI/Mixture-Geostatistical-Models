  })
  
  Consts <- list(n = length(y), dists = dists, zero = rep(0, length(y)), theta = max(dists) / 3)
  Inits <- list (beta0 = 0, omega=0.5, p=0.5 , phi=50, sigma2 = 1, W = rep(0, Consts$n))
  mcmc.out6 <- nimbleMCMC(code = Code, data = Data, constants = Consts, inits = Inits,
                          niter = n.itr, nburnin = n.burn, thin =  n.thin, nchains = 2, 
                          monitors = c( 'beta0', 'omega','p','phi','sigma2','mu', 'y'),
                          summary = TRUE, WAIC = TRUE)
  
  bayes.est6 = mcmc.out6$summary$all.chain[c(1, 389, 390, 391,392), ]
  Output6[[t]] <- bayes.est6
