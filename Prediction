        (2/0.05) * (y[miss.location[i]] - y.predict5[miss.location[i] , 5])
    }else{
      IS5.y[i] = y.predict5[miss.location[i] , 5] - y.predict5[miss.location[i] , 4]
    }
  }
  IS5.yy[t] = mean(IS5.y)
  
  
  # CRPS for y
  CRPS5.y = c()
  for(i in 1:length(miss.location)){
    CRPS5.y[i] = crps_sample(y = y[miss.location[i]], dat = mcmc.out5$samples[, 392:778][, miss.location[i]])
  }
  CRPS5.yy[t] = mean(CRPS5.y)
  
  
  # APE for y
  APE5.yy[t] = mean(abs(y.predict5[miss.location, 6] - y[miss.location]))
  
  #__________________________________________________________
  # Define Model 06 (FB)
  #__________________________________________________________
  
  Code <- nimbleCode({
    # Model
    for(i in 1:n){
      logit(mu[i]) <- beta0 + sqrt(sigma2)*W[i]
      y[i] ~ dFB(mu[i], phi, p, omega)
    }
    
    
    # Gaussian Process
    Sigma[1:n, 1:n] <- expcov(dists[1:n, 1:n], theta)
    W[1:n] ~ dmnorm(zero[1:n], cov = Sigma[1:n, 1:n])
    
    
    # Priors
    beta0 ~ dnorm(0, var = 100)
    phi ~ dgamma(0.01, 0.01)
    p ~ dunif(0, 1)
    omega ~ dunif(0, 1)
    sigma2 <- exp(sigmastar)
    sigmastar ~ dunif(-2, 2)
    
  })
  
  Consts <- list(n = length(y), dists = dists, zero = rep(0, length(y)), theta = max(dists) / 3)
  Inits <- list (beta0 = 0, omega=0.5, p=0.5 , phi=50, sigma2 = 1, W = rep(0, Consts$n))
  mcmc.out6 <- nimbleMCMC(code = Code, data = Data, constants = Consts, inits = Inits,
                          niter = n.itr, nburnin = n.burn, thin =  n.thin, nchains = 1, 
                          monitors = c( 'beta0', 'omega','p','phi','sigma2','mu', 'y'),
                          summary = TRUE, WAIC = TRUE)
  
  
  y.predict6 = cbind(mcmc.out6$summary[393:779, ], Mode = apply(mcmc.out6$samples[, 393:779], 2, getmode))
  
  # IS for y
  IS6.y = c()
  for(i in 1:length(miss.location)){
    if(y[miss.location[i]] < y.predict6[miss.location[i] , 4]){
      IS6.y[i] = (y.predict6[miss.location[i] , 5] - y.predict6[miss.location[i] , 4]) +
        (2/0.05) * (y.predict6[miss.location[i] , 4] - y[miss.location[i]])
    }else if(y[miss.location[i]] > y.predict6[miss.location[i] , 5]){
      IS6.y[i] = (y.predict6[miss.location[i] , 5] - y.predict6[miss.location[i] , 4]) +
        (2/0.05) * (y[miss.location[i]] - y.predict6[miss.location[i] , 5])
    }else{
      IS6.y[i] = y.predict6[miss.location[i] , 5] - y.predict6[miss.location[i] , 4]
    }
  }
  IS6.yy[t] = mean(IS6.y)
  
  
  # CRPS for y
  CRPS6.y = c()
  for(i in 1:length(miss.location)){
    CRPS6.y[i] = crps_sample(y = y[miss.location[i]], dat = mcmc.out6$samples[, 393:779][, miss.location[i]])
  }
  CRPS6.yy[t] = mean(CRPS6.y)
  
  
  # APE for y
  APE6.yy[t] = mean(abs(y.predict6[miss.location, 6] - y[miss.location]))

}
